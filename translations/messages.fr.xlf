<?xml version="1.0" encoding="UTF-8"?>
<xliff xmlns="urn:oasis:names:tc:xliff:document:1.2" version="1.2">
  <file source-language="en" target-language="fr" datatype="plaintext" original="messages">
    <body>
      <trans-unit id="1">
        <source>%agent% editing %file%</source>
        <target>%agent% modifie %file%</target>
      </trans-unit>
      <trans-unit id="2">
        <source>%agent% reading %file%</source>
        <target>%agent% lit %file%</target>
      </trans-unit>
      <trans-unit id="3">
        <source>%count% agents</source>
        <target>%count% agents</target>
      </trans-unit>
      <trans-unit id="4">
        <source>Go to %file% (%agent%)</source>
        <target>Aller à %file% (%agent%)</target>
      </trans-unit>
      <trans-unit id="5">
        <source>Stop showing agents</source>
        <target>Ne plus afficher les agents</target>
      </trans-unit>
      <trans-unit id="6">
        <source>Send Selection to Claude Code</source>
        <target>Envoyer la sélection à Claude Code</target>
      </trans-unit>
      <trans-unit id="7">
        <source>No Claude Code is connected — run /ide in claude, or start claude in the terminal</source>
        <target>Aucun Claude Code n'est connecté — lancez /ide dans claude, ou démarrez claude dans le terminal</target>
      </trans-unit>
      <trans-unit id="8">
        <source>Review Claude's Proposed Change</source>
        <target>Examiner la modification proposée par Claude</target>
      </trans-unit>
      <trans-unit id="9">
        <source>No change from Claude is waiting</source>
        <target>Aucune modification de Claude en attente</target>
      </trans-unit>
      <trans-unit id="10">
        <source>Claude proposes changes to %file%</source>
        <target>Claude propose des modifications à %file%</target>
      </trans-unit>
      <trans-unit id="11">
        <source>Accept — keep and save</source>
        <target>Accepter — garder et enregistrer</target>
      </trans-unit>
      <trans-unit id="12">
        <source>Reject — put the old text back</source>
        <target>Refuser — remettre l'ancien texte</target>
      </trans-unit>
      <trans-unit id="13">
        <source>Claude proposed a change to %file%, which has unsaved edits here — save or discard them, then ask again</source>
        <target>Claude a proposé une modification de %file%, qui a des modifications non enregistrées ici — enregistrez-les ou abandonnez-les, puis redemandez</target>
      </trans-unit>
      <trans-unit id="14">
        <source>No difference: the proposal is the text as it is</source>
        <target>Aucune différence : la proposition est le texte tel quel</target>
      </trans-unit>
      <trans-unit id="15">
        <source>Claude proposes changes to %file% — Ctrl+Alt+Y keep · Ctrl+Alt+U put back</source>
        <target>Claude propose des modifications à %file% — Ctrl+Alt+Y garder · Ctrl+Alt+U remettre</target>
      </trans-unit>
      <trans-unit id="16">
        <source>Kept Claude's change to %file%</source>
        <target>Modification de Claude à %file% conservée</target>
      </trans-unit>
      <trans-unit id="17">
        <source>Put %file% back as it was</source>
        <target>%file% remis tel qu'il était</target>
      </trans-unit>
      <trans-unit id="18">
        <source>Accept Claude's Change</source>
        <target>Accepter la modification de Claude</target>
      </trans-unit>
      <trans-unit id="19">
        <source>Reject Claude's Change</source>
        <target>Refuser la modification de Claude</target>
      </trans-unit>
    </body>
  </file>
</xliff>
