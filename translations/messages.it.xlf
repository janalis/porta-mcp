<?xml version="1.0" encoding="UTF-8"?>
<xliff xmlns="urn:oasis:names:tc:xliff:document:1.2" version="1.2">
  <file source-language="en" target-language="it" datatype="plaintext" original="messages">
    <body>
      <trans-unit id="1">
        <source>%agent% editing %file%</source>
        <target>%agent% modifica %file%</target>
      </trans-unit>
      <trans-unit id="2">
        <source>%agent% reading %file%</source>
        <target>%agent% legge %file%</target>
      </trans-unit>
      <trans-unit id="3">
        <source>%count% agents</source>
        <target>%count% agenti</target>
      </trans-unit>
      <trans-unit id="4">
        <source>Go to %file% (%agent%)</source>
        <target>Vai a %file% (%agent%)</target>
      </trans-unit>
      <trans-unit id="5">
        <source>Stop showing agents</source>
        <target>Non mostrare più gli agenti</target>
      </trans-unit>
      <trans-unit id="6">
        <source>Send Selection to Claude Code</source>
        <target>Invia la selezione a Claude Code</target>
      </trans-unit>
      <trans-unit id="7">
        <source>No Claude Code is connected — run /ide in claude, or start claude in the terminal</source>
        <target>Nessun Claude Code connesso — esegui /ide in claude o avvia claude nel terminale</target>
      </trans-unit>
      <trans-unit id="8">
        <source>Review Claude's Proposed Change</source>
        <target>Rivedi la modifica proposta da Claude</target>
      </trans-unit>
      <trans-unit id="9">
        <source>No change from Claude is waiting</source>
        <target>Nessuna modifica di Claude in attesa</target>
      </trans-unit>
      <trans-unit id="10">
        <source>Claude proposes changes to %file%</source>
        <target>Claude propone modifiche a %file%</target>
      </trans-unit>
      <trans-unit id="11">
        <source>Accept — keep and save</source>
        <target>Accetta — mantieni e salva</target>
      </trans-unit>
      <trans-unit id="12">
        <source>Reject — put the old text back</source>
        <target>Rifiuta — ripristina il testo precedente</target>
      </trans-unit>
      <trans-unit id="13">
        <source>Claude proposed a change to %file%, which has unsaved edits here — save or discard them, then ask again</source>
        <target>Claude ha proposto una modifica a %file%, che qui ha modifiche non salvate — salvale o scartale, poi chiedi di nuovo</target>
      </trans-unit>
    </body>
  </file>
</xliff>
