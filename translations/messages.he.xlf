<?xml version="1.0" encoding="UTF-8"?>
<xliff xmlns="urn:oasis:names:tc:xliff:document:1.2" version="1.2">
  <file source-language="en" target-language="he" datatype="plaintext" original="messages">
    <body>
      <trans-unit id="1">
        <source>%agent% editing %file%</source>
        <target>%agent% עורך את %file%</target>
      </trans-unit>
      <trans-unit id="2">
        <source>%agent% reading %file%</source>
        <target>%agent% קורא את %file%</target>
      </trans-unit>
      <trans-unit id="3">
        <source>%count% agents</source>
        <target>%count% סוכנים</target>
      </trans-unit>
      <trans-unit id="4">
        <source>Go to %file% (%agent%)</source>
        <target>מעבר אל %file% (%agent%)</target>
      </trans-unit>
      <trans-unit id="5">
        <source>Stop showing agents</source>
        <target>הפסק להציג סוכנים</target>
      </trans-unit>
      <trans-unit id="6">
        <source>Send Selection to Claude Code</source>
        <target>שליחת הבחירה ל־Claude Code</target>
      </trans-unit>
      <trans-unit id="7">
        <source>No Claude Code is connected — run /ide in claude, or start claude in the terminal</source>
        <target>אין Claude Code מחובר — הריצו ‎/ide‎ ב־claude, או הפעילו את claude במסוף</target>
      </trans-unit>
      <trans-unit id="8">
        <source>Review Claude's Proposed Change</source>
        <target>סקירת השינוי שהציע Claude</target>
      </trans-unit>
      <trans-unit id="9">
        <source>No change from Claude is waiting</source>
        <target>אין שינוי מ־Claude שממתין</target>
      </trans-unit>
      <trans-unit id="10">
        <source>Claude proposes changes to %file%</source>
        <target>Claude מציע שינויים ב־%file%</target>
      </trans-unit>
      <trans-unit id="11">
        <source>Accept — keep and save</source>
        <target>קבלה — שמירה</target>
      </trans-unit>
      <trans-unit id="12">
        <source>Reject — put the old text back</source>
        <target>דחייה — החזרת הטקסט הקודם</target>
      </trans-unit>
      <trans-unit id="13">
        <source>Claude proposed a change to %file%, which has unsaved edits here — save or discard them, then ask again</source>
        <target>Claude הציע שינוי ב־%file%, שיש בו כאן שינויים שלא נשמרו — שמרו או בטלו אותם ובקשו שוב</target>
      </trans-unit>
      <trans-unit id="14">
        <source>No difference: the proposal is the text as it is</source>
        <target>אין הבדל: ההצעה זהה לטקסט הקיים</target>
      </trans-unit>
    </body>
  </file>
</xliff>
