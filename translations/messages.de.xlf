<?xml version="1.0" encoding="UTF-8"?>
<xliff xmlns="urn:oasis:names:tc:xliff:document:1.2" version="1.2">
  <file source-language="en" target-language="de" datatype="plaintext" original="messages">
    <body>
      <trans-unit id="1">
        <source>%agent% editing %file%</source>
        <target>%agent% bearbeitet %file%</target>
      </trans-unit>
      <trans-unit id="2">
        <source>%agent% reading %file%</source>
        <target>%agent% liest %file%</target>
      </trans-unit>
      <trans-unit id="3">
        <source>%count% agents</source>
        <target>%count% Agenten</target>
      </trans-unit>
      <trans-unit id="4">
        <source>Go to %file% (%agent%)</source>
        <target>Zu %file% (%agent%)</target>
      </trans-unit>
      <trans-unit id="5">
        <source>Stop showing agents</source>
        <target>Agenten nicht mehr anzeigen</target>
      </trans-unit>
      <trans-unit id="6">
        <source>Send Selection to Claude Code</source>
        <target>Auswahl an Claude Code senden</target>
      </trans-unit>
      <trans-unit id="7">
        <source>No Claude Code is connected — run /ide in claude, or start claude in the terminal</source>
        <target>Kein Claude Code verbunden — /ide in claude ausführen oder claude im Terminal starten</target>
      </trans-unit>
      <trans-unit id="8">
        <source>Review Claude's Proposed Change</source>
        <target>Von Claude vorgeschlagene Änderung prüfen</target>
      </trans-unit>
      <trans-unit id="9">
        <source>No change from Claude is waiting</source>
        <target>Keine Änderung von Claude ausstehend</target>
      </trans-unit>
      <trans-unit id="10">
        <source>Claude proposes changes to %file%</source>
        <target>Claude schlägt Änderungen an %file% vor</target>
      </trans-unit>
      <trans-unit id="11">
        <source>Accept — keep and save</source>
        <target>Annehmen — behalten und speichern</target>
      </trans-unit>
      <trans-unit id="12">
        <source>Reject — put the old text back</source>
        <target>Ablehnen — alten Text wiederherstellen</target>
      </trans-unit>
      <trans-unit id="13">
        <source>Claude proposed a change to %file%, which has unsaved edits here — save or discard them, then ask again</source>
        <target>Claude hat eine Änderung an %file% vorgeschlagen, die hier ungespeicherte Änderungen hat — speichern oder verwerfen, dann erneut fragen</target>
      </trans-unit>
      <trans-unit id="14">
        <source>No difference: the proposal is the text as it is</source>
        <target>Kein Unterschied: der Vorschlag ist der unveränderte Text</target>
      </trans-unit>
    </body>
  </file>
</xliff>
